{
  "name": "margin",
  "version": "0.2.1",
  "description": "A local manual review workspace for Markdown and LaTeX manuscripts.",
  "license": "MIT",
  "type": "module",
  "main": "desktop/main.mjs",
  "author": "Margin contributors",
  "homepage": "https://github.com/Becomingw/Margin#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Becomingw/Margin.git"
  },
  "bugs": {
    "url": "https://github.com/Becomingw/Margin/issues"
  },
  "keywords": [
    "latex",
    "academic-writing",
    "manuscript",
    "review",
    "markdown",
    "annotations",
    "local-first",
    "writing-assistant"
  ],
  "bin": {
    "margin": "bin/margin.mjs"
  },
  "files": [
    "server.mjs",
    "config.mjs",
    "agent-providers.mjs",
    "api-adapter.mjs",
    "agent-context.mjs",
    "markdown.mjs",
    "review-store.mjs",
    "review-package.mjs",
    "names.mjs",
    "env.mjs",
    "desktop/",
    "NOTICE.md",
    "DESIGN.md",
    "bin/",
    "public/",
    "schemas/",
    "examples/",
    "scripts/setup.mjs",
    "scripts/doctor.mjs",
    "scripts/demo.mjs",
    "scripts/reanchor-confirmations.mjs",
    "docs/*.md",
    "README.md",
    "README.zh-CN.md",
    "LICENSE",
    "THIRD_PARTY.md",
    "CHANGELOG.md",
    "SECURITY.md",
    "AGENTS.md",
    "llms.txt",
    "CITATION.cff",
    ".env.example",
    "margin.config.example.json"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "doctor": "node scripts/doctor.mjs",
    "start": "node server.mjs",
    "dev": "node --watch server.mjs",
    "demo": "node scripts/demo.mjs",
    "check": "node scripts/check.mjs",
    "screenshots": "node scripts/review-screenshots.mjs",
    "desktop": "electron .",
    "desktop:pack": "electron-builder --dir --publish never",
    "desktop:dist": "electron-builder --publish never",
    "test:desktop": "node scripts/desktop-smoke.mjs",
    "test:markdown": "node scripts/markdown-smoke.mjs",
    "test": "npm run check && npm run test:portable && npm run test:suite",
    "test:portable": "node tests/portable.mjs",
    "test:suite": "node tests/run.mjs"
  },
  "dependencies": {
    "katex": "^0.18.1",
    "markdown-it": "^15.0.2",
    "markdown-it-footnote": "^4.0.0",
    "mathjax-full": "^3.2.2",
    "parse5": "^8.0.1"
  },
  "overrides": {
    "@xmldom/xmldom": "^0.9.12"
  },
  "devDependencies": {
    "electron": "44.7.0",
    "electron-builder": "26.15.3",
    "playwright": "1.64.0"
  }
}
