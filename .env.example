# Margin machine settings. No AI provider, model or API key is needed.
# Copy to .env beside package.json, never inside a manuscript repository.
# Shell values take precedence. Leave blank for defaults.

# Loopback by default. CLI --port wins; 0 selects a free port.
MARGIN_HOST=
MARGIN_PORT=

# Optional external-agent MCP. Empty disables it; use a random private value.
# Never put this token in manuscript config. Desktop creates its own scoped token.
MARGIN_MCP_TOKEN=
# For the stdio bridge only (the running server's /mcp endpoint):
# MARGIN_MCP_URL=http://127.0.0.1:4317/mcp

# Allow a trusted project to name a custom LaTeX command.
MARGIN_ALLOW_CUSTOM_LATEX=

# Shell only: "none" disables the app's .env file.
# MARGIN_ENV_FILE=none

# Desktop launcher environment only: optional separate app-data directory.
# MARGIN_DESKTOP_DATA_DIR=
# MARGIN_DESKTOP_TOKEN is internal; never configure it yourself.

# Retained configuration guards for legacy files; model execution is disabled.
MARGIN_ALLOW_CUSTOM_COMMANDS=
MARGIN_ALLOW_PROJECT_BASE_URL=
MARGIN_ALLOW_PROJECT_KEY_ENV=
